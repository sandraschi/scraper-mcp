# scraper-mcp Configuration
# Copy to .env and fill in values

# Server
SCRAPER_MCP_HOST=127.0.0.1
SCRAPER_MCP_PORT=10998
SCRAPER_MCP_WEBAPP_PORT=10999

# LLM Gateway (optional — for AI-powered improvement suggestions)
LLM_GATEWAY_URL=http://127.0.0.1:10916
LLM_GATEWAY_PROVIDER=
LLM_GATEWAY_MODEL=

# AI Watcher (optional — for grade drop alerts)
AIWATCHER_URL=http://127.0.0.1:10946

# Grade drop alert threshold
SCRAPER_ALERT_THRESHOLD=B

# Fleet registry path (optional)
# SCRAPER_FLEET_REGISTRY=
